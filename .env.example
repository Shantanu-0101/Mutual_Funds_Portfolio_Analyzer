# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Grok answers every question; Groq (free tier) steps in only when Grok is rate-limited or unavailable.
# Both lines are optional: config.yaml already uses these. Use "none" as the fallback to switch it off,
# or LLM_PROVIDER=mock to run offline.
LLM_PROVIDER=grok
LLM_FALLBACK=groq

GROK_API_KEY=
GROQ_API_KEY=

# Optional, other providers
XAI_API_KEY=
GEMINI_API_KEY=
